<Window
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:vm="using:Mesen.ViewModels"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="430" d:DesignHeight="250"
	x:Class="Mesen.Windows.ChallengeReplayPromptWindow"
	Width="430" SizeToContent="Height" MinHeight="170"
	CanResize="False"
	x:DataType="vm:ChallengeReplayPromptViewModel"
	Title="Replay"
>
	<!-- Muted text is defined per theme variant so it stays readable in both (same approach as
	     ChallengeAnnouncementWindow). -->
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.ThemeDictionaries>
				<ResourceDictionary x:Key="Default">
					<SolidColorBrush x:Key="ChallengeMutedBrush" Color="#5A5A64" />
				</ResourceDictionary>
				<ResourceDictionary x:Key="Light">
					<SolidColorBrush x:Key="ChallengeMutedBrush" Color="#5A5A64" />
				</ResourceDictionary>
				<ResourceDictionary x:Key="Dark">
					<SolidColorBrush x:Key="ChallengeMutedBrush" Color="#A8A8B4" />
				</ResourceDictionary>
			</ResourceDictionary.ThemeDictionaries>
		</ResourceDictionary>
	</Window.Resources>

	<DockPanel Margin="16">
		<!-- Fetching. Shown from the moment the window opens, so a slow download never looks
		     like nothing happened. -->
		<StackPanel DockPanel.Dock="Top" IsVisible="{Binding IsLoading}" Spacing="10">
			<TextBlock Text="Loading replay…" TextWrapping="Wrap" />
			<ProgressBar IsIndeterminate="True" Height="4" />
		</StackPanel>

		<!-- Failed. Reported in place with a retry, instead of a separate message box. -->
		<StackPanel DockPanel.Dock="Top" IsVisible="{Binding HasError}" Spacing="6">
			<TextBlock Text="Couldn't open this replay" FontWeight="Bold" />
			<TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
		</StackPanel>

		<!-- Which Lauf this is. Everything here was read out of the package itself. -->
		<StackPanel DockPanel.Dock="Top" IsVisible="{Binding IsReady}">
			<TextBlock Text="{Binding ChallengeName}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />

			<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0 10 0 0">
				<TextBlock Grid.Row="0" Grid.Column="0" Text="Player" IsVisible="{Binding HasPlayer}"
				           Foreground="{DynamicResource ChallengeMutedBrush}" Margin="0 0 12 0" />
				<TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Player}" IsVisible="{Binding HasPlayer}"
				           TextTrimming="CharacterEllipsis" />

				<TextBlock Grid.Row="1" Grid.Column="0" Text="Time" IsVisible="{Binding HasTotalTime}"
				           Foreground="{DynamicResource ChallengeMutedBrush}" Margin="0 3 12 0" />
				<StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0 3 0 0">
					<TextBlock Text="{Binding TotalTime}" FontFamily="Consolas,Menlo,monospace"
					           IsVisible="{Binding HasTotalTime}" />
					<TextBlock Text="{Binding Segments}" Foreground="{DynamicResource ChallengeMutedBrush}" />
				</StackPanel>
			</Grid>

			<!-- Warnings only appear when they apply, so the window stays quiet in the normal case. -->
			<StackPanel Margin="0 12 0 0" Spacing="4">
				<TextBlock IsVisible="{Binding IsChallengeMissing}" TextWrapping="Wrap"
				           Text="This challenge isn't installed yet - it will be downloaded and installed first." />
				<TextBlock IsVisible="{Binding !CanRace}" TextWrapping="Wrap"
				           Foreground="{DynamicResource ChallengeMutedBrush}"
				           Text="This replay has no ghost data, so it can't be raced." />
			</StackPanel>

			<!-- Install progress, shown in place of nothing happening for several megabytes. -->
			<StackPanel IsVisible="{Binding IsInstalling}" Margin="0 12 0 0" Spacing="6">
				<TextBlock Text="{Binding InstallStatus}" TextWrapping="Wrap" />
				<ProgressBar IsIndeterminate="True" Height="4" />
			</StackPanel>
		</StackPanel>

		<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
		            Spacing="6" Margin="0 18 0 0">
			<Button Content="Try again" MinWidth="90" HorizontalContentAlignment="Center"
			        IsVisible="{Binding CanRetry}" Click="Retry_Click" />
			<!-- Grouped so a running install disables both at once (IsEnabled propagates to
			     children), without the view model having to carry a combined flag. -->
			<StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsReady}"
			            IsEnabled="{Binding !IsInstalling}">
				<Button Content="Watch Replay" MinWidth="110" HorizontalContentAlignment="Center"
				        IsDefault="True" Click="Watch_Click" />
				<Button Content="Race as Ghost" MinWidth="110" HorizontalContentAlignment="Center"
				        IsEnabled="{Binding CanRace}" Click="Race_Click" />
			</StackPanel>
			<Button Content="Cancel" MinWidth="80" HorizontalContentAlignment="Center"
			        IsCancel="True" Click="Cancel_Click" />
		</StackPanel>

		<Panel />
	</DockPanel>
</Window>
